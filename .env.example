# 实际模型 ID 以账号可访问的配置为准，不会自动切换模型。
MODEL_PROVIDER=huanling
HUANLING_BASE_URL=https://ai.huanling.icu
# 三种任务分别使用对应分组的 Key，不能混用。
HUANLING_API_KEY=
HUANLING_IMAGE_API_KEY=
HUANLING_VIDEO_API_KEY=
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-stream-upload
# 原生 Gemini 可设 MODEL_PROVIDER=gemini，并改用对应的模型 ID
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TEXT_MODEL=gemini-3.8-flash
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1536x864
IMAGE_QUALITY=low
# 保留 Kie 规划／评审，单独使用词元生图时：
# IMAGE_PROVIDER=ciyuan
# IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_PROVIDER=huanling
CIYUAN_IMAGE_API_KEY=
# 使用 MODEL_PROVIDER=ciyuan 时，规划／评审读取此独立密钥。
CIYUAN_API_KEY=
CIYUAN_BASE_URL=https://www.gpt345.com
# 0 表示未限定；例如 12 将要求镜头总时长为 12 秒。
TARGET_DURATION=0
VIDEO_REVIEW_MODEL=gemini-3.8-flash
MINIMAX_API_KEY=
VIDEO_PROVIDER=huanling
# 公开关键帧托管：uguu 约3小时后过期；kie 需要 KIE_API_KEY 和可用上传配额。
VIDEO_UPLOAD_PROVIDER=uguu
# 幻灵目前只列出标准 H3，Lite 480P 协议核实前阻止创建和查询。
# 用户明确允许本次标准版时，在命令环境中设 MINIMAX_MODEL=MiniMax-H3、
# MINIMAX_RESOLUTION=768P，并使用新运行目录。图片托管由 VIDEO_UPLOAD_PROVIDER 显式选择。
# 使用已支持的 MiniMax 官方接口时显式设 VIDEO_PROVIDER=minimax。
# 国际站：https://api.minimax.io；中国站：https://api.minimax.cn，需与密钥所属站点一致
MINIMAX_BASE_URL=https://ai.huanling.icu
MINIMAX_MODEL=MiniMax-H3-Lite
MINIMAX_RESOLUTION=480P
NUM_SCRIPTS=1
NUM_SHOT_PLANS=1
NUM_DIRECTIONS=1
NUM_STORYBOARDS=1
NUM_VIDEO_CANDIDATES=1
NUM_ITERATIONS=2

# 中文字幕字体：修改为本机实际可用、支持中文的字体路径
SUBTITLE_FONT=/System/Library/Fonts/STHeiti Medium.ttc

# 本地 OCR：默认沿用 MAGI；中文漫画建议显式设置 rapidocr（安装 .[local-ocr]）。
LOCAL_OCR_PROVIDER=magi

# 幻灵文本接口：native 或 compatible；显式选择，不自动切换
HUANLING_TEXT_API=native
# 本机代理无法访问该渠道时可显式设置 NO_PROXY=ai.huanling.icu

# 文本接口的显式传输选择；系统 curl 可避免部分本机 Python TLS 不兼容
HUANLING_TEXT_TRANSPORT=requests
# 图片请求使用系统 TLS；单次提交，不自动切换或重试。
HUANLING_IMAGE_TRANSPORT=curl
HUANLING_VIDEO_TRANSPORT=curl

# Agent 文本输入的本地估算预算；不是模型上下文容量或计费 token。
AGENT_CONTEXT_BUDGET=32000
