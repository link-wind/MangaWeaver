{
  "name": "mangaweaver-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MangaWeaver 本地漫画转动画工作台",
  "author": "MangaWeaver",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "pack": "node node_modules/electron/install.js && npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  },
  "build": {
    "appId": "local.mangaweaver.desktop",
    "productName": "MangaWeaver",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "THIRD_PARTY_UI.md",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.video"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
